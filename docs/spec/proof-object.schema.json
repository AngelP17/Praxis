{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/schemas/proof-object-v0.1.json",
  "title": "Praxis Proof Object",
  "description": "A verifiable, deterministic proof artifact for AI-assisted operational decisions.",
  "type": "object",
  "required": [
    "proof_id",
    "run_id",
    "solution_pack",
    "customer_context_hash",
    "evidence",
    "ontology",
    "decision",
    "action",
    "value_case",
    "replay",
    "proof_hash",
    "generated_at"
  ],
  "properties": {
    "proof_id": {
      "type": "string",
      "pattern": "^proof_praxis_[a-z0-9_]+_\\d{3}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^fieldlab_run_[a-z0-9_]+$"
    },
    "solution_pack": {
      "type": "string",
      "minLength": 1
    },
    "customer_context_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": ["raw_events", "sources", "source_coverage", "evidence_trust"],
      "properties": {
        "raw_events": { "type": "integer", "minimum": 1 },
        "sources": { "type": "array", "items": { "type": "string" } },
        "source_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "corroboration_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_trust": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ontology": {
      "type": "object",
      "required": ["objects_created", "links_created", "mapping_confidence"],
      "properties": {
        "objects_created": { "type": "integer", "minimum": 1 },
        "links_created": { "type": "integer", "minimum": 1 },
        "actions_available": { "type": "integer", "minimum": 0 },
        "mapping_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "decision": {
      "type": "object",
      "required": ["root_cause_hypothesis", "priority_score", "requires_human_review"],
      "properties": {
        "root_cause_hypothesis": { "type": "string", "minLength": 1 },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "requires_human_review": { "type": "boolean" },
        "next_best_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["recommended_action", "mode", "actor", "status", "action_log_hash"],
      "properties": {
        "recommended_action": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["human_approval", "read_only", "assisted_action", "writeback"] },
        "actor": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "action_log_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "run_id": { "type": "string" }
      }
    },
    "value_case": {
      "type": "object",
      "required": ["estimated_annual_value", "confidence", "primary_value_driver"],
      "properties": {
        "estimated_annual_value": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "primary_value_driver": { "type": "string" }
      }
    },
    "replay": {
      "type": "object",
      "required": ["replay_hash", "deterministic", "verified_at"],
      "properties": {
        "replay_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "deterministic": { "type": "boolean" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "proof_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "required": ["signing_alg", "signer_kid", "signature_hex", "public_key_hex"],
      "properties": {
        "signing_alg": { "type": "string", "const": "ed25519" },
        "signer_kid": { "type": "string" },
        "signature_hex": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
        "public_key_hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "attestation": {
      "type": "object",
      "properties": {
        "log": { "type": "string" },
        "entry_id": { "type": "string" },
        "log_index": { "type": "number" },
        "inclusion_proof": { "type": "object" }
      }
    }
  }
}
