{
  "framework": "nextjs",
  "buildCommand": "cd apps/web && pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/.next",
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/"
    },
    "platform-service": {
      "entrypoint": "services/platform-service",
      "routePrefix": "/_/platform-service"
    }
  }
}
