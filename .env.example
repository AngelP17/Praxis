# Praxis Environment Configuration
# Copy this file to .env and update values for your environment

# Database
DATABASE_URL=sqlite:///./praxis.db
# Production: DATABASE_URL=postgresql://user:pass@localhost:5432/praxis

# Security
SECRET_KEY=replace-with-openssl-rand-base64-32-output
# Generate: openssl rand -base64 32

# Environment
ENV=development
DEBUG=true
# Production: ENV=production, DEBUG=false
# When ENV=production the gateway enforces bearer-token auth on mutating and
# customer-data routes, blocks startup if shipped demo credentials are active,
# and adds HSTS. The frontend must attach bearer tokens to gateway calls.

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example: ALLOWED_ORIGINS=https://praxis.example.com,https://app.praxis.example.com

# Feature flags
AUTO_INIT_DB=true

# Optional: external user store
# USERS_FILE=/path/to/users.json
# Production note: rotate or replace the demo users in users.json before exposing real data.

# Decision Service
DECISION_SERVICE_URL=http://localhost:8001
PLATFORM_SERVICE_URL=http://localhost:8080

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=120

# Logging
LOG_LEVEL=INFO
# Production: LOG_LEVEL=WARNING
LOG_FORMAT=json
# Options: json, console
