# Aether Sentinel Environment Configuration
# Copy this file to .env and update values for your environment

# Database
DATABASE_URL=sqlite:///./aether-sentinel.db
# Production: DATABASE_URL=postgresql://user:pass@localhost:5432/aether_sentinel

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-base64-32
# Generate: openssl rand -base64 32

# Environment
ENV=development
DEBUG=true
# Production: ENV=production, DEBUG=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: ALLOWED_ORIGINS=https://yourdomain.com

# Feature flags
AUTO_INIT_DB=true

# Optional: external user store
# USERS_FILE=/path/to/users.json

# Decision Service
DECISION_SERVICE_URL=http://localhost:8001
PLATFORM_SERVICE_URL=http://localhost:8080

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=120

# Logging
LOG_LEVEL=INFO
# Production: LOG_LEVEL=WARNING
LOG_FORMAT=json
# Options: json, console
