{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env",
    "**/.env.*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint:gpt-taste": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint:gpt-taste:ci": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:smoke": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "test-results/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    }
  }
}
